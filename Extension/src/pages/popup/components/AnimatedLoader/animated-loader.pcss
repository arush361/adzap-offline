.animated-loader {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.animated-loader__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* AdZap Offline: pulsing shield loader */
.animated-loader__icon {
    width: 72px;
    height: 72px;
    animation: adzap-pulse 1.2s ease-in-out infinite;
}

@keyframes adzap-pulse {
    0%, 100% { transform: scale(0.9); opacity: 0.7; }
    50% { transform: scale(1); opacity: 1; }
}
